    "In a large bowl, mix together the flour, baking powder, salt, and sugar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a large bowl, mix together the flour, baking powder, salt, and sugar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un bol grande, mezcla la harina, el polvo de hornear, la sal y el azúcar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un grand bol, mélangez la farine, la levure chimique, le sel et le sucre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなボウルで小麦粉、ベーキングパウダー、塩、砂糖を混ぜます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大碗中混合面粉、泡打粉、盐和糖。"
          }
        }
      }
    },
    "In a separate pan, cook the pancetta until crispy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a separate pan, cook the pancetta until crispy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En otra sartén, cocina la panceta hasta que esté crujiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une autre poêle, faites cuire la pancetta jusqu’à ce qu’elle soit croustillante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のフライパンでパンチェッタをカリッとするまで焼きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一个锅中将意式培根煎至酥脆。"
          }
        }
      }
    },
