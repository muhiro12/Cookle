    "Heat a lightly oiled griddle or frying pan over medium-high heat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat a lightly oiled griddle or frying pan over medium-high heat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta una plancha o sartén ligeramente aceitada a fuego medio-alto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites chauffer une plaque ou une poêle légèrement huilée à feu moyen-vif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄く油をひいた鉄板またはフライパンを中火から強火で熱します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将抹少许油的煎锅或平底锅用中高火加热。"
          }
        }
      }
    },
    "Heat the oil in a large pot over medium heat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat the oil in a large pot over medium heat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta el aceite en una olla grande a fuego medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites chauffer l’huile dans une grande casserole à feu moyen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな鍋に油を入れ、中火で熱します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大锅中用中火加热油。"
          }
        }
      }
    },
    "Heat the oil in a large pot over medium-high heat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat the oil in a large pot over medium-high heat."
