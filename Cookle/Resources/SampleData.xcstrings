            "state" : "translated",
            "value" : "Bring to a boil, then reduce the heat and simmer for 2 hours, until the beef is tender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva a ebullición, baja el fuego y cocina a fuego lento durante 2 horas, hasta que la carne esté tierna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
