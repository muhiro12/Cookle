    "Add the bell peppers and broccoli, and cook until tender." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the bell peppers and broccoli, and cook until tender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los pimientos y el brócoli, y cocina hasta que estén tiernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les poivrons et le brocoli, puis faites cuire jusqu’à ce qu’ils soient tendres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パプリカとブロッコリーを加え、やわらかくなるまで炒めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入彩椒和西兰花，炒至变软。"
          }
        }
      }
    },
    "Add the carrots, potatoes, and celery, and cook for another 5 minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the carrots, potatoes, and celery, and cook for another 5 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las zanahorias, las papas y el apio, y cocina 5 minutos más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les carottes, les pommes de terre et le céleri, puis faites cuire encore 5 minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "にんじん、じゃがいも、セロリを加え、さらに5分煮ます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入胡萝卜、土豆和芹菜，再煮 5 分钟。"
          }
        }
      }
    },
    "Add the chicken and cook until browned." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the chicken and cook until browned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el pollo y cocina hasta que se dore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le poulet et faites-le dorer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鶏肉を加え、焼き色がつくまで炒めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入鸡肉，煎炒至上色。"
          }
        }
      }
    },
    "Add the chopped onions and garlic, and sauté until golden brown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the chopped onions and garlic, and sauté until golden brown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la cebolla picada y el ajo, y sofríe hasta que estén dorados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les oignons émincés et l’ail, puis faites revenir jusqu’à ce qu’ils soient dorés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刻んだ玉ねぎとにんにくを加え、きつね色になるまで炒めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入切碎的洋葱和大蒜，炒至金黄。"
          }
        }
      }
    },
    "Add the chopped onions, carrots, and potatoes to the pot and cook for 5 minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the chopped onions, carrots, and potatoes to the pot and cook for 5 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las cebollas, las zanahorias y las papas picadas a la olla y cocina 5 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les oignons, les carottes et les pommes de terre coupés dans la casserole, puis faites cuire 5 minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刻んだ玉ねぎ、にんじん、じゃがいもを鍋に加え、5分炒めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将切好的洋葱、胡萝卜和土豆加入锅中，煮 5 分钟。"
          }
        }
      }
    },
    "Add the garlic and ginger, and cook for another minute." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the garlic and ginger, and cook for another minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el ajo y el jengibre, y cocina un minuto más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez l’ail et le gingembre, puis faites cuire encore une minute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "にんにくとしょうがを加え、さらに1分炒めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入大蒜和姜，再炒 1 分钟。"
          }
        }
      }
    },
