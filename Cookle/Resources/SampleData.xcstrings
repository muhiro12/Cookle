        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沸騰したら火を弱め、牛肉がやわらかくなるまで2時間煮込みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮沸后转小火炖 2 小时，直到牛肉变软。"
          }
        }
