    "Heat the oil in a large skillet over medium-high heat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat the oil in a large skillet over medium-high heat."
          }
        },
        "es" : {
