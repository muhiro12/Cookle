    },
    "This permanently deletes all recipes, diaries, tags, and photos from this device. Export your data first if you need to keep it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes all recipes, diaries, tags, and photos from this device. Export your data first if you need to keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina permanentemente de este dispositivo todas las recetas, entradas del diario, etiquetas y fotos. Si necesitas conservar los datos, expórtalos primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement de cet appareil toutes les recettes, les entrées du journal, les étiquettes et les photos. Si vous souhaitez conserver les données, exportez-les d’abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を実行すると、このデバイス上のすべてのレシピ、日記、タグ、写真が完全に削除されます。データを残す必要がある場合は、先にデータを書き出してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会永久删除此设备上的所有食谱、日记、标签和照片。如果需要保留这些数据，请先导出数据。"
          }
        }
      }
    },
    "This permanently deletes all recipes, diaries, tags, and photos. The deletions sync to other devices using the same iCloud account. Export your data first if you need to keep it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes all recipes, diaries, tags, and photos. The deletions sync to other devices using the same iCloud account. Export your data first if you need to keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina permanentemente todas las recetas, entradas del diario, etiquetas y fotos. Las eliminaciones se sincronizan con otros dispositivos que utilizan la misma cuenta de iCloud. Si necesitas conservar los datos, expórtalos primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement toutes les recettes, les entrées du journal, les étiquettes et les photos. Les suppressions sont synchronisées avec les autres appareils utilisant le même compte iCloud. Si vous souhaitez conserver les données, exportez-les d’abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を実行すると、すべてのレシピ、日記、タグ、写真が完全に削除されます。削除内容は、同じiCloudアカウントを使用しているほかのデバイスにも同期されます。データを残す必要がある場合は、先にデータを書き出してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会永久删除所有食谱、日记、标签和照片。删除内容会同步到使用同一iCloud账户的其他设备。如果需要保留这些数据，请先导出数据。"
          }
        }
      }
    },
    "This permanently deletes the photo. No recipes will be changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes the photo. No recipes will be changed."
