    "This will reassign recipes from %lld matching tags to %@, then delete the duplicate tags." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will reassign recipes from %lld matching tags to %@, then delete the duplicate tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reasignará las recetas de %lld etiquetas coincidentes a %@ y después eliminará las etiquetas duplicadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action réaffecte les recettes de %lld étiquettes correspondantes à %@, puis supprime les étiquettes en double."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致する%lld件のタグからレシピを%@に付け替えたうえで、重複したタグを削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将 %lld 个匹配标签的食谱改为使用%@，然后删除重复的标签。"
          }
        }
      }
    },
