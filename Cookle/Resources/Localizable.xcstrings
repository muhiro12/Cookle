          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas recetas del archivo coinciden con nombres de recetas actuales. Compara las versiones y elige cuál conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces recettes du fichier portent des noms de recettes actuelles. Comparez les versions et choisissez celles à conserver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
