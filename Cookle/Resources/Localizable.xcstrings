    "Some days in this file already have more than one diary on this device. Open Diaries and merge duplicate diary entries, then import again. Your data was not changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some days in this file already have more than one diary on this device. Open Diaries and merge duplicate diary entries, then import again. Your data was not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos días de este archivo ya tienen más de un diario en este dispositivo. Abre Diarios, combina las entradas duplicadas y vuelve a importar. Tus datos no se modificaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains jours de ce fichier ont déjà plusieurs journaux sur cet appareil. Ouvrez Journaux, fusionnez les entrées en double, puis importez à nouveau. Vos données n’ont pas été modifiées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルに含まれる日のなかに、このデバイスですでに日記が複数ある日があります。日記を開いて重複した日記を統合してから、もう一度取り込んでください。データは変更されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件涉及的某些日期在此设备上已有多篇日记。请打开“日记”合并重复的日记，然后重新导入。你的数据未被更改。"
          }
        }
      }
    },
