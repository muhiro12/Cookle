        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importation est irréversible. Exportez d’abord vos données actuelles pour pouvoir y revenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込みは元に戻せません。元の状態に戻せるよう、先に現在のデータを書き出してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入无法撤销。请先导出当前数据，以便需要时恢复。"
          }
        }
      }
    },
