    "Export your data to keep a copy you can import on any device. Export before importing or deleting, because neither can be undone. Delete All permanently removes recipes, diaries, tags, and photos from this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your data to keep a copy you can import on any device. Export before importing or deleting, because neither can be undone. Delete All permanently removes recipes, diaries, tags, and photos from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus datos para guardar una copia que puedas importar en cualquier dispositivo. Exporta antes de importar o eliminar, porque ninguna de las dos acciones se puede deshacer. Eliminar todo borra de forma permanente las recetas, diarios, etiquetas y fotos de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données pour conserver une copie que vous pourrez importer sur n’importe quel appareil. Exportez-les avant d’importer ou de supprimer, car ces actions sont irréversibles. Tout supprimer efface définitivement les recettes, journaux, étiquettes et photos de cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを書き出すと、どのデバイスでも取り込めるコピーを残せます。取り込みや削除は元に戻せないため、その前に書き出してください。すべて削除すると、このデバイスからレシピ、日記、タグ、写真が完全に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出数据可保留一份副本，并可在任何设备上导入。导入和删除都无法撤销，请在操作前先导出。“全部删除”会从此设备永久移除食谱、日记、标签和照片。"
          }
        }
      }
    },
    "Export your data to keep a copy you can import on any device. Export before importing or deleting, because neither can be undone. Imports and Delete All sync to other devices using the same iCloud account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your data to keep a copy you can import on any device. Export before importing or deleting, because neither can be undone. Imports and Delete All sync to other devices using the same iCloud account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus datos para guardar una copia que puedas importar en cualquier dispositivo. Exporta antes de importar o eliminar, porque ninguna de las dos acciones se puede deshacer. Las importaciones y Eliminar todo se sincronizan con otros dispositivos que usan la misma cuenta de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données pour conserver une copie que vous pourrez importer sur n’importe quel appareil. Exportez-les avant d’importer ou de supprimer, car ces actions sont irréversibles. Les importations et Tout supprimer se synchronisent avec les autres appareils utilisant le même compte iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを書き出すと、どのデバイスでも取り込めるコピーを残せます。取り込みや削除は元に戻せないため、その前に書き出してください。取り込みとすべて削除は、同じiCloudアカウントを使うほかのデバイスにも同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出数据可保留一份副本，并可在任何设备上导入。导入和删除都无法撤销，请在操作前先导出。导入和“全部删除”会同步到使用同一 iCloud 账户的其他设备。"
          }
        }
      }
    },
