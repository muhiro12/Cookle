    "New items are added, and items with the same recipe name or diary day are updated with the file's content. Items that are only on this device stay. This can't be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New items are added, and items with the same recipe name or diary day are updated with the file's content. Items that are only on this device stay. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añaden los elementos nuevos, y los que tienen el mismo nombre de receta o día de diario se actualizan con el contenido del archivo. Los elementos que solo están en este dispositivo se mantienen. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux éléments sont ajoutés, et ceux qui ont le même nom de recette ou le même jour de journal sont mis à jour avec le contenu du fichier. Les éléments présents uniquement sur cet appareil sont conservés. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい項目は追加され、レシピ名や日記の日付が同じ項目はファイルの内容で更新されます。このデバイスにしかない項目はそのまま残ります。この操作は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新项目会被添加，食谱名称或日记日期相同的项目会用文件内容更新。仅在此设备上的项目会保留。此操作无法撤销。"
          }
        }
      }
    },
