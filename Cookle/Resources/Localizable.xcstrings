    "This restores the recipe input from before the import and also discards the changes you made after importing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This restores the recipe input from before the import and also discards the changes you made after importing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto restaura la entrada de la receta anterior a la importación y también descarta los cambios que hiciste después de importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela rétablit la saisie de la recette d’avant l’importation et supprime aussi les modifications effectuées après l’importation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込む前のレシピの入力に戻します。取り込んだ後に行った変更も破棄されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将恢复导入前的食谱输入，并同时丢弃导入后所做的更改。"
          }
        }
      }
    },
    "This stops the active cooking guide and any running timer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This stops the active cooking guide and any running timer."
