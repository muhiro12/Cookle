    "Delete is available only when no recipes use this ingredient. %@ is still used by %lld recipes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete is available only when no recipes use this ingredient. %@ is still used by %lld recipes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se puede eliminar cuando ninguna receta usa este ingrediente. %@ todavía se usa en %lld recetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression n’est possible que si aucune recette n’utilise cet ingrédient. %@ est encore utilisé par %lld recettes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この材料を使っているレシピがない場合のみ削除できます。%@は%lld件のレシピで使われています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当没有食谱使用该食材时才能删除。%@仍被 %lld 个食谱使用。"
          }
        }
      }
    },
    "Delete is available only when no recipes use this ingredient. %@ is still used by one recipe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete is available only when no recipes use this ingredient. %@ is still used by one recipe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se puede eliminar cuando ninguna receta usa este ingrediente. %@ todavía se usa en una receta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression n’est possible que si aucune recette n’utilise cet ingrédient. %@ est encore utilisé par une recette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この材料を使っているレシピがない場合のみ削除できます。%@は1件のレシピで使われています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当没有食谱使用该食材时才能删除。%@仍被 1 个食谱使用。"
          }
        }
      }
    },
