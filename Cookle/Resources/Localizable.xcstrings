          }
        }
      }
    },
    "Cookle has multiple categories named %@. Open Cookle and merge the duplicates before running this shortcut again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle has multiple categories named %1$@. Open Cookle and merge the duplicates before running this shortcut again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle tiene varias categorías llamadas %1$@. Abre Cookle y combina los duplicados antes de volver a ejecutar este atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle contient plusieurs catégories nommées %1$@. Ouvrez Cookle et fusionnez les doublons avant de relancer ce raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle に「%1$@」という名前のカテゴリが複数あります。Cookle を開いて重複を統合してから、このショートカットをもう一度実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle 中有多个名为“%1$@”的分类。请打开 Cookle 合并重复项，然后再次运行此快捷指令。"
          }
        }
      }
    },
    "Cookle has multiple ingredients named %@. Open Cookle and merge the duplicates before running this shortcut again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle has multiple ingredients named %1$@. Open Cookle and merge the duplicates before running this shortcut again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle tiene varios ingredientes llamados %1$@. Abre Cookle y combina los duplicados antes de volver a ejecutar este atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle contient plusieurs ingrédients nommés %1$@. Ouvrez Cookle et fusionnez les doublons avant de relancer ce raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle に「%1$@」という名前の材料が複数あります。Cookle を開いて重複を統合してから、このショートカットをもう一度実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle 中有多个名为“%1$@”的食材。请打开 Cookle 合并重复项，然后再次运行此快捷指令。"
          }
        }
      }
    },
    "Cookle will keep the newest entry for each day, combine its meals and different notes, and remove only the extra entries. Recipes stay saved. The changes sync to other devices using the same iCloud account. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle will keep the newest entry for each day, combine its meals and different notes, and remove only the extra entries. Recipes stay saved. The changes sync to other devices using the same iCloud account. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle conservará la entrada más reciente de cada día, combinará sus comidas y notas diferentes, y eliminará solo las entradas adicionales. Las recetas seguirán guardadas. Los cambios se sincronizarán con otros dispositivos que usen la misma cuenta de iCloud. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle conservera l’entrée la plus récente de chaque jour, fusionnera ses repas et les notes différentes, et supprimera uniquement les entrées supplémentaires. Les recettes resteront enregistrées. Les modifications seront synchronisées avec les autres appareils utilisant le même compte iCloud. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookleは日付ごとに最新の日記を残し、食事と異なるメモをまとめ、余分な日記だけを削除します。レシピは保持されます。変更は同じiCloudアカウントを使用するほかのデバイスにも同期されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle 会保留每天最新的日记，合并其中的餐食和不同备注，并仅删除多余的日记。食谱会继续保留。更改将同步到使用同一 iCloud 账户的其他设备。此操作无法撤销。"
          }
        }
      }
    },
    "Cookle will keep the newest entry for each day, combine its meals and different notes, and remove only the extra entries. Recipes stay saved. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle will keep the newest entry for each day, combine its meals and different notes, and remove only the extra entries. Recipes stay saved. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle conservará la entrada más reciente de cada día, combinará sus comidas y notas diferentes, y eliminará solo las entradas adicionales. Las recetas seguirán guardadas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle conservera l’entrée la plus récente de chaque jour, fusionnera ses repas et les notes différentes, et supprimera uniquement les entrées supplémentaires. Les recettes resteront enregistrées. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookleは日付ごとに最新の日記を残し、食事と異なるメモをまとめ、余分な日記だけを削除します。レシピは保持されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookle 会保留每天最新的日记，合并其中的餐食和不同备注，并仅删除多余的日记。食谱会继续保留。此操作无法撤销。"
          }
        }
      }
    },
