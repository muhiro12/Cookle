        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento es distinto cuando coincide el nombre de la receta o el día del diario, pero no el contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
