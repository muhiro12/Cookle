          }
        }
      }
    },
    "This deletes all current recipes, diaries, tags, and photos and replaces them with the file's content. The change syncs to other devices using the same iCloud account. This can't be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes all current recipes, diaries, tags, and photos and replaces them with the file's content. The change syncs to other devices using the same iCloud account. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina todas las recetas, diarios, etiquetas y fotos actuales y los reemplaza con el contenido del archivo. El cambio se sincroniza con otros dispositivos que usan la misma cuenta de iCloud. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime toutes les recettes, journaux, étiquettes et photos actuels et les remplace par le contenu du fichier. La modification se synchronise avec les autres appareils utilisant le même compte iCloud. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のレシピ、日記、タグ、写真をすべて削除し、ファイルの内容に置き換えます。この変更は、同じiCloudアカウントを使うほかのデバイスにも同期されます。この操作は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除所有当前的食谱、日记、标签和照片，并用文件内容替换。此更改会同步到使用同一 iCloud 账户的其他设备。此操作无法撤销。"
          }
        }
      }
    },
    "This deletes all recipes, diaries, tags, and photos on this device and replaces them with the file's content. This can't be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes all recipes, diaries, tags, and photos on this device and replaces them with the file's content. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina todas las recetas, diarios, etiquetas y fotos de este dispositivo y los reemplaza con el contenido del archivo. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime toutes les recettes, journaux, étiquettes et photos de cet appareil et les remplace par le contenu du fichier. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上のレシピ、日記、タグ、写真をすべて削除し、ファイルの内容に置き換えます。この操作は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除此设备上的所有食谱、日记、标签和照片，并用文件内容替换。此操作无法撤销。"
          }
        }
      }
    },
    "This deletes the photo from %lld recipe entries. The recipes stay saved." : {
      "localizations" : {
