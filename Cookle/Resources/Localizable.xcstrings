    "A current recipe cannot be replaced by more than one recipe from the file, or be kept and replaced at once. Review the recipe choices." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A current recipe cannot be replaced by more than one recipe from the file, or be kept and replaced at once. Review the recipe choices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una receta actual no puede reemplazarse por más de una receta del archivo ni conservarse y reemplazarse a la vez. Revisa las opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une recette actuelle ne peut pas être remplacée par plusieurs recettes du fichier ni conservée et remplacée à la fois. Vérifiez les choix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ現在のレシピを、ファイル内の複数のレシピで置き換えたり、残すと置き換えるを同時に選んだりすることはできません。レシピの選択を見直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一当前食谱不能被文件中的多个食谱替换，也不能同时保留和替换。请检查食谱选项。"
          }
        }
      }
    },
