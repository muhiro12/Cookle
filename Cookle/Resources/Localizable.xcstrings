    "Replacing changes only this day's meals and note. Combining keeps every current meal and adds meals from the file the day does not already have, keeping repeated meals. Different notes are both kept, separated by a line." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacing changes only this day's meals and note. Combining keeps every current meal and adds meals from the file the day does not already have, keeping repeated meals. Different notes are both kept, separated by a line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar solo cambia las comidas y la nota de este día. Combinar conserva todas las comidas actuales y añade las comidas del archivo que el día aún no tiene, manteniendo las comidas repetidas. Si las notas son distintas, se conservan ambas separadas por una línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer ne modifie que les repas et la note de ce jour. Combiner conserve tous les repas actuels et ajoute les repas du fichier que ce jour n’a pas encore, en gardant les repas répétés. Des notes différentes sont toutes deux conservées, séparées par une ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置き換えでは、この日の食事とメモだけが変わります。統合では、現在の食事をすべて残し、この日にまだないファイルの食事を追加します。同じ食事の繰り返しも保たれます。メモが異なる場合は、区切り線を挟んで両方残します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换只会更改这一天的餐食和备注。合并会保留所有当前餐食，并添加这一天还没有的文件中的餐食，重复的餐食也会保留。不同的备注会同时保留，并以分隔线隔开。"
          }
        }
      }
    },
