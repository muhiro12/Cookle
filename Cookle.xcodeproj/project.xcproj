{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "es",
      "fr",
      "ja",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/muhiro12/MHPlatform",
      "version": {
        "up-to-next-major-version": "1.16.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SimplyDanny/SwiftLintPlugins",
      "version": {
        "up-to-next-major-version": "0.65.1",
      },
    }, {
      "kind": "local",
      "path": "CookleLibrary",
    }, {
      "kind": "remote",
      "repository": "https://github.com/muhiro12/MHUI",
      "version": {
        "up-to-next-major-version": "2.4.0",
      },
    },
  ],
  "files": [
    { "path": "CookleLibrary" },
    {
      "kind": "folder",
      "path": "Cookle",
      "target-membership": [
        "Cookle",
      ],
      "membership-exceptions": [
        {
          "target": "Cookle",
          "exclusions": [
            "Configurations/Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets",
      "target-membership": [
        "Widgets",
      ],
      "membership-exceptions": [
        {
          "target": "Widgets",
          "exclusions": [
            "Configurations/Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Watch", "target-membership": [ "Watch" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Cookle.app", "id": "AD8C8E682BFABEE200872BF2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Widgets.appex", "id": "AD277E6F2E8449CC00B4AC19", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Cookle/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Watch.app", "id": "ADB8C61C2F9293B500C59D93", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Cookle/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "Widgets/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "Widgets/frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Cookle",
      "id": "AD8C8E672BFABEE200872BF2",
      "product": "Products/Cookle.app",
      "product-type": "application",
      "dependencies": [
        "Widgets",
        "Watch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "product-name": "CookleLibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHPlatform",
          "product-name": "MHAppRuntimeAds",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHPlatform",
          "product-name": "MHPlatform",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHUI",
          "product-name": "MHUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Cookle/Configurations/Cookle.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_ASSET_PATHS": "",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Cookle/Configurations/Info.plist",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.food-and-drink",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Use the camera to take photos of your dishes or scan recipe text.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "4.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.muhiro12.Cookle",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Widgets",
      "id": "AD277E6E2E8449CC00B4AC19",
      "product": "Products/Widgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "CookleLibrary",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
