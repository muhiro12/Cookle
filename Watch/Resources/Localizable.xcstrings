    "Copies saved from iPhone. Recent edits appear when iPhone is nearby.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies saved from iPhone. Recent edits appear when iPhone is nearby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias guardadas desde el iPhone. Los cambios recientes aparecen cuando el iPhone está cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies enregistrées depuis l’iPhone. Les modifications récentes apparaissent quand l’iPhone est à proximité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneから保存したコピーです。最近の編集はiPhoneが近くにあるときに反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iPhone 保存的副本。iPhone 在附近时会显示最近的编辑。"
          }
        }
      }
    },
