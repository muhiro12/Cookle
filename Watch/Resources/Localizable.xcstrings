    "This stops the active cooking guide and any running timer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops the active cooking guide and any running timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の調理ガイドと実行中のタイマーを停止します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detendrá la guía de cocina activa y cualquier temporizador en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action arrête le guide de cuisine actif et tout minuteur en cours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将停止当前的烹饪指南和正在运行的计时器。"
          }
        }
      }
    },
