    "Begin an active cooking session in Cookle on your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin an active cooking session in Cookle on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión de cocina activa en Cookle desde tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez une session de cuisine active dans Cookle sur votre iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の Cookle で調理セッションを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 iPhone 上的 Cookle 中开始烹饪会话。"
          }
        }
      }
    },
