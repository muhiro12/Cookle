    "Update Cookle on iPhone to sync cooking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Cookle on iPhone to sync cooking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Cookle en el iPhone para sincronizar la cocina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Cookle sur l’iPhone pour synchroniser la cuisine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調理を同期するにはiPhoneのCookleをアップデートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 iPhone 上的 Cookle 以同步烹饪。"
          }
        }
      }
    },
