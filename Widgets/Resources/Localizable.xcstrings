    "Show a chosen recipe, or use Last Opened, Latest, or Random.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a chosen recipe, or use Last Opened, Latest, or Random."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una receta elegida, la última abierta, la más reciente o una al azar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez une recette choisie, la dernière consultée, la plus récente ou une recette aléatoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したレシピ、最後に開いたレシピ、最新、ランダムから表示を選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示指定食谱，或选择最近打开、最新或随机食谱。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
